#: Public/templates/default/index.tpl:30
msgid "AUTHENTICATION REFUSED, please check your user/password!"
msgstr "ANMELDUNG FEHLGESCHLAGEN, bitte überprüfen Sie Ihren Benutzernamen und Ihr Passwort!"

#: Public/templates/default/index.tpl:32
msgid "INACTIVE ACCOUNT, Please activate your account!"
msgstr "INAKTIVES KONTO, bitte aktivieren Sie Ihr Konto!"

#: Public/templates/default/index.tpl:34
msgid "BLOCKED ACCOUNT, Please contact the administrator!"
msgstr "GESPERRTES KONTO, bitte wenden Sie sich an den Administrator!"

#: Public/templates/default/index.tpl:38
msgid "Login"
msgstr "Benutzername"

#: Public/templates/default/index.tpl:40
msgid "Password"
msgstr "Passwort"

#: Public/templates/default/index.tpl:43
msgid "Keep me signed in"
msgstr "Angemeldet bleiben"

#: Public/templates/default/index.tpl:44
msgid "LOGIN"
msgstr "ANMELDEN"

#: Public/templates/default/index.tpl:63
msgid "You must enter an user and a password!"
msgstr "Bitte geben Sie einen Benutzernamen und ein Passwort ein!"

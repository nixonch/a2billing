#: Public/templates/default/index.tpl:34
msgid "BLOCKED ACCOUNT, Please contact the administrator!"
msgstr "ОБЛІКОВИЙ ЗАПИС ЗАБЛОКОВАНО, зверніться до адміністратора!"

#: Public/templates/default/index.tpl:38
msgid "Login"
msgstr "Логін"

#: Public/templates/default/index.tpl:40
msgid "Password"
msgstr "Пароль"

#: Public/templates/default/index.tpl:43
msgid "Keep me signed in"
msgstr "Запам'ятати мене"

#: Public/templates/default/index.tpl:44
msgid "LOGIN"
msgstr "УВІЙТИ"

#: Public/templates/default/index.tpl:63
msgid "You must enter an user and a password!"
msgstr "Введіть логін і пароль!"

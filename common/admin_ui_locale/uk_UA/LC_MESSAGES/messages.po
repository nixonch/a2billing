#: Public/templates/default/index.tpl:30
msgid "AUTHENTICATION REFUSED, please check your user/password!"
msgstr "АВТЕНТИФІКАЦІЮ ВІДХИЛЕНО, перевірте логін і пароль!"

#: Public/templates/default/index.tpl:32
msgid "INACTIVE ACCOUNT, Please activate your account!"

{
  "name": "sipde.net/a2billing",
  "description": "Phone billing system based on PHP",
  "require": {
    "php": "^7.4 || ^8.0",
    "ext-gd": "*",
    "phpsysinfo/phpsysinfo": "^3.4.7",
    "mitoteam/jpgraph": "^10.5",
    "adodb/adodb-php": "~5.22.12",
    "smarty/smarty": "^5.0",
    "guzzlehttp/guzzle": "^7.10",
    "google/cloud-speech": "^0.24.0",
    "google/cloud-storage": "^1.12",
    "phpmailer/phpmailer": "^6.1",
    "league/iso3166": "^4.0"
  },
  "license": "AGPL",
  "authors": [
    {
      "name": "Areski Belaid",
      "email": "areski@gmail.com"
    },
    {
      "name": "Nick Mitin",
      "email": "nick@sipde.net",
      "homepage": "https://sipde.net/"
    }
  ],
  "config": {
    "platform": { "php": "7.4.33" },
    "platform-check": true,
    "allow-plugins": false
  },
  "scripts": {
    "post-install-cmd": "@php ../../addons/script/configure-phpsysinfo.php",
    "post-update-cmd": "@php ../../addons/script/configure-phpsysinfo.php"
  },
  "minimum-stability": "stable",
  "prefer-stable" : true
}
